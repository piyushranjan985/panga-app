# --- Database ---
# Local docker-compose default. Point this at Neon/Supabase/RDS in staging & prod.
DATABASE_URL="postgresql://panga:panga@localhost:5432/panga?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
SESSION_JWT_SECRET="dev-only-change-me-please-generate-a-real-secret"
SESSION_COOKIE_NAME="panga_session"

# --- Social login (Google) ---
# Blank (default): "Continue with Google" on the login page falls back to
# a mock consent form (no external calls, same as OTP_PROVIDER="mock") --
# fully testable with zero setup.
#
# Google: create an OAuth 2.0 Client ID at console.cloud.google.com
# (Web application), add ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# under "Authorized redirect URIs", fill in the OAuth consent screen
# (app name, support email, privacy policy URL). Free at any volume.
# While the consent screen is in "Testing" status only accounts you add
# as test users can sign in -- submit for verification (also free, and
# fast for the plain openid/email/profile scopes requested here) to open
# it to everyone. See lib/auth/googleOAuth.ts for the full writeup.
#
# Facebook and Instagram sign-in were both removed (2026-09-29 and
# 2026-09-27 respectively) -- Instagram never had a real consumer OAuth
# to begin with, and Facebook's Business Verification requires a
# registered business entity findmyVybe doesn't have, while most dating
# apps (Tinder, Hinge, Bumble) have themselves moved away from it in
# favor of phone number + Google/Apple.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OTP / SMS provider (mocked in dev) ---
# While this is "mock" (the default), phone/email sign-in is open to any
# number or address -- there's no per-person check on this path. What
# gates it instead is lib/otp.ts's fixed code (MOCK_OTP, currently
# 43364336) -- it's never shown anywhere in the app or an API response,
# so someone has to be told it directly by you. A per-code attempt cap
# and a per-user request cooldown (also in lib/otp.ts) keep that fixed
# code from being brute forced. Wire this up to MSG91 / Gupshup / Twilio
# Verify (real, random, per-request codes) before shipping to real users
# -- a shared fixed code is fine for a small closed beta, not beyond it.
OTP_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Allowlist (lib/auth/betaAllowlist.ts) for the mock Google button and
# the real Google OAuth callback ONLY -- phone/email sign-in (above) uses
# the fixed-code model instead, not this list. The mock Google route
# accepts any email with zero verification, so it stays blocked (this
# list empty = blocked for everyone) unless you deliberately open it here.
#
# Comma-separated phone numbers (+91XXXXXXXXXX, exactly as typed into
# the app) and/or email addresses (case-insensitive) allowed to sign in.
BETA_ALLOWLIST=""
# Set to "true" to remove the allowlist check on those routes too,
# without deleting BETA_ALLOWLIST or touching any code.
BETA_ALLOWLIST_OPEN="false""

# --- Verification (Indian government ID, via DigiLocker/API Setu) ---
# "mock" (default): simulates the whole flow with no external calls, so
# the verify -> pending -> verified/manual_review/rejected state machine
# is fully testable today. Pass
# ?scenario=match|dob_mismatch|duplicate|underage|name_mismatch to
# POST /api/verification to exercise a specific outcome.
# "digilocker": the real flow (OAuth2 redirect to DigiLocker, see
# lib/safety/identityVerification.ts). Requires DIGILOCKER_CLIENT_ID/
# SECRET below, which in turn requires findmyVybe's own organization to
# complete registration + KYC/approval on the API Setu Partners portal
# (apisetu.gov.in) first -- that's a real-world approval process, not
# something achievable from this codebase. The API itself is free; only
# the approval step takes calendar time.
VERIFICATION_PROVIDER="mock"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
# Defaults below point at DigiLocker's published OAuth endpoints -- only
# override if your API Setu approval packet says otherwise.
DIGILOCKER_AUTHORIZE_URL="https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize"
DIGILOCKER_TOKEN_URL="https://digilocker.meripehchaan.gov.in/public/oauth2/1/token"
DIGILOCKER_API_BASE="https://digilocker.meripehchaan.gov.in/public/oauth2/3"

# HMAC key used to detect the same government ID behind two accounts,
# without ever storing the raw document number. Generate with:
# openssl rand -base64 32
DUPLICATE_CHECK_PEPPER="dev-only-change-me-please-generate-a-real-secret"

# --- Photo moderation (nudity + face-presence check on every profile photo) ---
# "mock" (default): always reports a clean single-face photo, no ML
# dependencies needed -- lets the upload -> moderate -> approve pipeline
# run end-to-end in dev/tests.
# "self-hosted": nsfwjs + @vladmandic/face-api, both free/MIT, running on
# plain @tensorflow/tfjs (pure JS) with jpeg-js/pngjs for image decoding --
# no native binaries anywhere in this path (an earlier version used the
# `canvas` package and that broke a real Vercel build outright -- see
# lib/safety/imageModeration.ts's doc comment), so it stays deployable on
# any plan. The npm packages are already in package.json, and
# scripts/download-face-api-models.mjs fetches the model weight files into
# FACE_API_MODEL_PATH automatically before every build/dev run (see
# package.json's "prebuild"/"predev") -- nothing to set up by hand beyond
# this env var. Set this on Vercel too (Production + Preview) and
# redeploy, or a car photo (or anything else) sails through unmoderated,
# same as VERIFICATION_PROVIDER=mock always "verifies" -- "mock" mode
# never actually looks at the image, by design, it just exercises the
# pipeline.
IMAGE_MODERATION_PROVIDER="mock"
FACE_API_MODEL_PATH="./public/models/face-api"

# --- App ---
NEXT_PUBLIC_APP_NAME="findmyVybe"
# Local dev default. Set per-environment in Vercel's Environment
# Variables (Project Settings -> Environment Variables), scoped by
# branch, NOT here:
#   Production (main branch)    -> https://findmyvybe.com
#   Preview, scoped to `develop` -> https://dev.findmyvybe.com
# Every OAuth redirect_uri (Google, see GOOGLE_CLIENT_ID above) and
# DigiLocker callback URL below is built from this one var, so setting it
# in Vercel is the actual "activation" step
# after DNS is pointed and Vercel issues the SSL cert -- editing this
# file alone changes nothing on a deployed environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "production" | "development" -- purely cosmetic/safety, never a
# security control (see components/DevEnvironmentBadge.tsx, which shows
# a small "DEV"/env-name badge on every page whenever this ISN'T exactly
# "production", and app/robots.ts, which stays closed to crawlers the
# same way). Set to "production" ONLY in Vercel's Production environment
# variables (main branch / findmyvybe.com); every other environment
# (local dev, the `develop` branch / dev.findmyvybe.com, any other
# preview) should leave this as "development" or unset -- unset fails
# safe by still showing the badge, rather than silently looking like prod.
NEXT_PUBLIC_APP_ENV="development"

# --- VybeHelp (in-app Help Center chat agent) ---
# Optional. VybeHelp works fully without this -- it answers from the
# Help Center content in lib/helpCenter.ts via deterministic retrieval
# (app/api/help/ask/route.ts). Set this to also have Claude phrase a more
# natural-language answer, strictly grounded in the same retrieved
# Help Center entries (never open-ended). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""

# --- Discover feed cache (lib/cache.ts) ---
# Optional. /api/discover works fully without this -- it just re-queries
# Postgres on every request instead of serving a short-lived per-city cache.
# Add the "Upstash for Redis" integration from the Vercel Marketplace (a few
# clicks, free tier) to turn caching on; it auto-injects KV_REST_API_URL/
# KV_REST_API_TOKEN, which lib/cache.ts already reads -- no code change
# needed. Only set these two directly if connecting a standalone Upstash
# database instead of using the Marketplace integration.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
