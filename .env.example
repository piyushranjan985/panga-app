# --- Database ---
# Local docker-compose default. Point this at Neon/Supabase/RDS in staging & prod.
DATABASE_URL="postgresql://panga:panga@localhost:5432/panga?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
SESSION_JWT_SECRET="dev-only-change-me-please-generate-a-real-secret"
SESSION_COOKIE_NAME="panga_session"

# --- Social login (Google) ---
# Blank (default): "Continue with Google" on the login page falls back to
# a mock consent form (no external calls, same as an unconfigured OTP
# channel below) -- fully testable with zero setup.
#
# Google: create an OAuth 2.0 Client ID at console.cloud.google.com
# (Web application), add ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# under "Authorized redirect URIs", fill in the OAuth consent screen
# (app name, support email, privacy policy URL). Free at any volume.
# While the consent screen is in "Testing" status only accounts you add
# as test users can sign in -- submit for verification (also free, and
# fast for the plain openid/email/profile scopes requested here) to open
# it to everyone. See lib/auth/googleOAuth.ts for the full writeup.
#
# Facebook and Instagram sign-in were both removed (2026-09-29 and
# 2026-09-27 respectively) -- Instagram never had a real consumer OAuth
# to begin with, and Facebook's Business Verification requires a
# registered business entity findmyVybe doesn't have, while most dating
# apps (Tinder, Hinge, Bumble) have themselves moved away from it in
# favor of phone number + Google/Apple.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Social login (Apple) ---
# Blank (default): "Continue with Apple" on the login page falls back to
# a mock consent form, same as Google above -- fully testable with zero
# setup. See lib/auth/appleOAuth.ts for the full writeup.
#
# Real Apple Sign-In requires an active Apple Developer Program
# enrollment ($99/yr) -- there's no free tier like Google's. Once
# enrolled, at developer.apple.com: register an App ID with "Sign In
# with Apple" enabled, create a Services ID (this is APPLE_CLIENT_ID --
# it does NOT match your App ID, e.g. "com.findmyvybe.web"), configure
# that Services ID with ${NEXT_PUBLIC_APP_URL}/api/auth/apple/callback
# as the "Return URL", and create a "Sign In with Apple" private key
# (downloads once as a .p8 file -- APPLE_KEY_ID is that key's ID,
# APPLE_PRIVATE_KEY is the .p8 file's contents). APPLE_TEAM_ID is your
# 10-character Developer account Team ID, shown on the membership page.
APPLE_TEAM_ID=""
APPLE_CLIENT_ID=""
APPLE_KEY_ID=""
# Paste the .p8 file's contents with literal "\n" in place of real
# newlines (lib/auth/appleOAuth.ts unescapes it) -- e.g.
# "-----BEGIN PRIVATE KEY-----\nMIGTAgEA...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=""

# --- Trusted device (skip re-OTP on return visits) ---
# Optional -- lib/trustedDevice.ts defaults to "findmyvybe_device" if
# unset. Only worth overriding if you're running multiple findmyVybe
# environments on the same parent domain and want their trusted-device
# cookies to not collide.
TRUSTED_DEVICE_COOKIE_NAME="findmyvybe_device"

# --- OTP: phone (StartMessaging or MSG91) and email (Brevo), each independently real-or-mock ---
# Phone and email sign-in each check their OWN channel's credentials
# below (lib/otp.ts's isChannelConfigured()) -- no single on/off switch
# for both, since you might wire one up before the other (email is free
# and zero-setup beyond an account + sender verification; phone needs
# either provider below -- see lib/notifications/sms.ts).
# Whichever channel's credentials are missing falls back to lib/otp.ts's
# fixed MOCK_OTP (currently 433643, never shown anywhere in the app or
# an API response) -- fine for local dev/a small closed beta, not beyond
# it. A per-code attempt cap and a per-user request cooldown (both in
# lib/otp.ts) keep that fixed code from being brute forced either way.
#
# SAFETY GUARD: lib/otp.ts's isMockOtpUnsafeInProduction() refuses to
# issue or verify any code at all (503, not a silent mock fallback) for
# whichever channel is still unconfigured once this is a real production
# deployment (VERCEL_ENV=production -- see lib/env.ts). Unlike the image-
# moderation/identity-verification guards, there's no safe degraded mode
# for "let someone sign in and check later" -- so this fails CLOSED. Set
# that channel's real credentials below before a real production launch,
# or sign-in on that channel stops working there.
#
# MOCK_MODE_PHONE / MOCK_MODE_EMAIL: an explicit, separate override for
# deliberately testing sign-in (anywhere, including a real production
# deployment) without sending real SMS/email -- set either to the exact
# string "true" and that channel always issues the fixed MOCK_OTP above,
# even though its real provider IS configured. Independent per channel,
# same as everything else here. Anything other than exactly "true"
# (unset, "false", blank) means off -- never defaults to mock. No
# equivalent exists for Google sign-in; that's untouched either way.
# Set in Vercel's Environment Variables (then redeploy) to affect the
# live site, not just local dev -- this file alone only affects
# `next dev`/local scripts.
MOCK_MODE_PHONE=""
MOCK_MODE_EMAIL=""

# --- OTP abuse/cost protection -- see docs/OTP_SECURITY.md and lib/otpRateLimit.ts ---
# Every value below has a sensible built-in default (shown in the comment)
# -- set a var here only to override it. All are read fresh from the
# environment on every request, so a Vercel env var change takes effect
# on the next request after redeploy, no code change needed.
#
# OTP_ENABLED is the emergency kill switch: set to exactly "false" and
# EVERY OTP issuance (phone AND email, real or mock) is refused
# immediately -- for an active-abuse or runaway-SMS-cost incident. This
# is blunter than MOCK_MODE_PHONE/EMAIL above (which keeps sign-in
# working on the mock code) -- OTP_ENABLED=false stops it outright.
OTP_ENABLED="true"
# How long a code is valid for, and the base resend cooldown per
# destination (a repeat request within this window for the SAME phone/
# email gets a 429) -- see computeProgressiveCooldownSeconds below for
# why "base": this escalates (doubles) on repeated back-to-back requests
# rather than staying fixed.
OTP_EXPIRY_SECONDS="300"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_PROGRESSIVE_COOLDOWN_ENABLED="true"
OTP_PROGRESSIVE_COOLDOWN_LOOKBACK_HOURS="3"
OTP_PROGRESSIVE_COOLDOWN_MAX_SECONDS="1800"
# Wrong-guess cap per code (lib/otp.ts's consumeOtp) -- once a single
# code hits this many wrong attempts it's permanently dead regardless of
# the correct answer; request a fresh one (subject to the cooldown above).
OTP_MAX_ATTEMPTS="10"
# Per-destination (phone number or email address) volume caps --
# independent per channel, since SMS costs money and email (Brevo) is
# free at this scale.
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR="5"
OTP_MAX_REQUESTS_PER_PHONE_PER_DAY="10"
OTP_MAX_REQUESTS_PER_EMAIL_PER_HOUR="5"
OTP_MAX_REQUESTS_PER_EMAIL_PER_DAY="10"
# Per-IP caps -- catches one source hammering many different numbers/
# emails, which the per-destination caps above can't see on their own.
OTP_MAX_REQUESTS_PER_IP_PER_HOUR="20"
OTP_MAX_REQUESTS_PER_IP_PER_DAY="60"
# Optional platform-wide safety valve -- unset (default) means no global
# cap at all. Only worth setting once real volume gives you a number to
# alarm on; sized too low, this takes down sign-in for EVERYONE the
# moment it's hit, so don't set it casually.
OTP_MAX_REQUESTS_GLOBAL_PER_HOUR=""
# A soft (never hard-blocking) daily cap substituted in place of the
# normal per-phone-number limit when lib/otpRateLimit.ts's
# isSuspiciousPhoneNumber() flags an obviously-fake test/bot pattern
# (all-same-digit, or the canonical 1234567890/9876543210-style runs) --
# an unlucky false positive still gets this many codes through today.
OTP_SUSPICIOUS_NUMBER_DAILY_LIMIT="1"
# Used only to print a rough, non-billing cost estimate in Vercel's logs
# every 50 real SMS sends (see lib/otp.ts) -- update it if your actual
# per-SMS rate differs meaningfully from StartMessaging's ~Rs 0.25.
OTP_SMS_COST_INR_ESTIMATE="0.25"
#
# PHONE/SMS has TWO interchangeable providers (lib/notifications/sms.ts
# picks between them automatically -- set either block below, or both and
# use SMS_PROVIDER to pick explicitly):
#
# StartMessaging -- no DLT registration needed (routes through their own
# pre-registered DLT entity + shared sender ID), live in minutes, flat
# ~Rs 0.25/OTP. The recommended way to get phone sign-in live FAST without
# waiting on DLT paperwork. Account + API key at startmessaging.com.
# NOTE: this integration hasn't been live-tested against a real
# StartMessaging account yet -- see the "NOT YET LIVE-TESTED" note at the
# top of lib/notifications/sms-startmessaging.ts before relying on it for
# real users; send yourself one real test OTP first.
STARTMESSAGING_API_KEY=""
#
# MSG91 -- needs your own DLT registration first (TRAI's mandatory
# registration for sending SMS to Indian numbers; a real-world KYC
# process done on MSG91's own onboarding flow, not something settable
# from code -- budget 24-48h for template approval once your entity is
# registered, plus a one-time fee, roughly Rs 11,800 total as of this
# research). In exchange: your own branded sender ID and a lower
# per-OTP cost once volume is high enough to amortize that setup cost
# (back-of-envelope: roughly 200-250k lifetime OTPs). Console at
# control.msg91.com. MSG91_AUTH_KEY is under Settings > API.
# MSG91_TEMPLATE_ID is the DLT-approved OTP template you create there --
# its approved text must contain MSG91's OTP variable placeholder, since
# DLT requires the exact approved wording. See lib/notifications/sms-msg91.ts
# for the full setup note.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
#
# SMS_PROVIDER: optional explicit override ("startmessaging" or "msg91").
# Leave unset to auto-detect -- StartMessaging is preferred when both are
# configured, since it's the faster, no-DLT-wait path. Set this once
# you've deliberately moved to MSG91 at scale, to make the choice
# explicit rather than implicit.
SMS_PROVIDER=""
#
# Brevo (email): free account at app.brevo.com -- 300 emails/day forever,
# no card required (as of researching this in 2026; verify current terms
# before relying on it). BREVO_API_KEY is under Settings > SMTP & API >
# API Keys. BREVO_SENDER_EMAIL must be a verified sender (Senders & IP >
# Senders) or Brevo will reject/spam-folder the mail. BREVO_SENDER_NAME
# is optional. See lib/notifications/email.ts.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="findmyVybe"

# Allowlist (lib/auth/betaAllowlist.ts) for the mock Google button and
# the real Google OAuth callback ONLY -- phone/email sign-in (above) uses
# the fixed-code model instead, not this list. The mock Google route
# accepts any email with zero verification, so it stays blocked (this
# list empty = blocked for everyone) unless you deliberately open it here.
#
# Comma-separated phone numbers (+91XXXXXXXXXX, exactly as typed into
# the app) and/or email addresses (case-insensitive) allowed to sign in.
BETA_ALLOWLIST=""
# Set to "true" to remove the allowlist check on those routes too,
# without deleting BETA_ALLOWLIST or touching any code.
BETA_ALLOWLIST_OPEN="false""

# --- Verification (Indian government ID, via DigiLocker/API Setu) ---
# "mock" (default): simulates the whole flow with no external calls, so
# the verify -> pending -> verified/manual_review/rejected state machine
# is fully testable today. Pass
# ?scenario=match|dob_mismatch|duplicate|underage|name_mismatch to
# POST /api/verification to exercise a specific outcome.
# "digilocker": the real flow (OAuth2 redirect to DigiLocker, see
# lib/safety/identityVerification.ts). Requires DIGILOCKER_CLIENT_ID/
# SECRET below, which in turn requires findmyVybe's own organization to
# complete registration + KYC/approval on the API Setu Partners portal
# (apisetu.gov.in) first -- that's a real-world approval process, not
# something achievable from this codebase. The API itself is free; only
# the approval step takes calendar time.
VERIFICATION_PROVIDER="mock"
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
# Defaults below point at DigiLocker's published OAuth endpoints -- only
# override if your API Setu approval packet says otherwise.
DIGILOCKER_AUTHORIZE_URL="https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize"
DIGILOCKER_TOKEN_URL="https://digilocker.meripehchaan.gov.in/public/oauth2/1/token"
DIGILOCKER_API_BASE="https://digilocker.meripehchaan.gov.in/public/oauth2/3"

# HMAC key used to detect the same government ID behind two accounts,
# without ever storing the raw document number. Generate with:
# openssl rand -base64 32
DUPLICATE_CHECK_PEPPER="dev-only-change-me-please-generate-a-real-secret"

# --- Photo moderation (nudity + face-presence check on every profile photo) ---
# "mock" (default): always reports a clean single-face photo, no ML
# dependencies needed -- lets the upload -> moderate -> approve pipeline
# run end-to-end in dev/tests.
# "self-hosted": nsfwjs + @vladmandic/face-api, both free/MIT, running on
# plain @tensorflow/tfjs (pure JS) with jpeg-js/pngjs for image decoding --
# no native binaries anywhere in this path (an earlier version used the
# `canvas` package and that broke a real Vercel build outright -- see
# lib/safety/imageModeration.ts's doc comment), so it stays deployable on
# any plan. The npm packages are already in package.json, and
# scripts/download-face-api-models.mjs fetches the model weight files into
# FACE_API_MODEL_PATH automatically before every build/dev run (see
# package.json's "prebuild"/"predev") -- nothing to set up by hand beyond
# this env var. Set this on Vercel too (Production + Preview) and
# redeploy, or a car photo (or anything else) sails through unmoderated,
# same as VERIFICATION_PROVIDER=mock always "verifies" -- "mock" mode
# never actually looks at the image, by design, it just exercises the
# pipeline.
# SAFETY NET if this still doesn't get set before a real prod deploy:
# lib/safety/imageModeration.ts's isUnsafeProductionMock() + moderateAndUpload.ts
# detect "mock provider + VERCEL_ENV=production" and force every photo to
# MANUAL_REVIEW instead of auto-approving, logging loudly each time -- so
# a missed env var degrades safely instead of silently approving explicit
# content. That's a backstop, not a substitute for setting this properly.
IMAGE_MODERATION_PROVIDER="mock"
FACE_API_MODEL_PATH="./public/models/face-api"

# --- App ---
NEXT_PUBLIC_APP_NAME="findmyVybe"
# Local dev default. Set per-environment in Vercel's Environment
# Variables (Project Settings -> Environment Variables), scoped by
# branch, NOT here:
#   Production (main branch)    -> https://findmyvybe.com
#   Preview, scoped to `develop` -> https://dev.findmyvybe.com
# Every OAuth redirect_uri (Google, see GOOGLE_CLIENT_ID above) and
# DigiLocker callback URL below is built from this one var, so setting it
# in Vercel is the actual "activation" step
# after DNS is pointed and Vercel issues the SSL cert -- editing this
# file alone changes nothing on a deployed environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "production" | "development" -- purely cosmetic/safety, never a
# security control (see components/DevEnvironmentBadge.tsx, which shows
# a small "DEV"/env-name badge on every page whenever this ISN'T exactly
# "production", and app/robots.ts, which stays closed to crawlers the
# same way). Set to "production" ONLY in Vercel's Production environment
# variables (main branch / findmyvybe.com); every other environment
# (local dev, the `develop` branch / dev.findmyvybe.com, any other
# preview) should leave this as "development" or unset -- unset fails
# safe by still showing the badge, rather than silently looking like prod.
NEXT_PUBLIC_APP_ENV="development"

# --- VybeHelp (in-app Help Center chat agent) ---
# Optional. VybeHelp works fully without this -- it answers from the
# Help Center content in lib/helpCenter.ts via deterministic retrieval
# (app/api/help/ask/route.ts). Set this to also have Claude phrase a more
# natural-language answer, strictly grounded in the same retrieved
# Help Center entries (never open-ended). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""

# --- Discover feed cache (lib/cache.ts) ---
# Optional. /api/discover works fully without this -- it just re-queries
# Postgres on every request instead of serving a short-lived per-city cache.
# Add the "Upstash for Redis" integration from the Vercel Marketplace (a few
# clicks, free tier) to turn caching on; it auto-injects KV_REST_API_URL/
# KV_REST_API_TOKEN, which lib/cache.ts already reads -- no code change
# needed. Only set these two directly if connecting a standalone Upstash
# database instead of using the Marketplace integration.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Scheduled jobs (Vercel Cron -- see vercel.json) ---
# Required for app/api/cron/mystery-match and app/api/cron/otp-cleanup --
# both refuse to run (500) without this set, rather than running
# unauthenticated. Vercel's own cron invocations send this automatically
# as a Bearer token once set in your Vercel project's Environment
# Variables (CRON_SECRET is a name Vercel recognizes specially for this);
# generate a random value with `openssl rand -base64 32`.
CRON_SECRET=""
