{
  "name": "vybematch-admin",
  "version": "0.1.0",
  "private": true,
  "description": "VybeMatch Admin Portal -- Operations, Trust & Safety, Support, Privacy/DPDP Compliance and Analytics console. Separate Next.js app in the same repo, sharing the consumer app's database (see prisma.config.ts).",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "seed": "tsx scripts/seed-admin.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^16.3.4",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.47",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
