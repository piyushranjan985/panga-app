# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# prisma
/prisma/dev.db

# face-api model weights -- downloaded at build/dev time by
# scripts/download-face-api-models.mjs, never checked in
/public/models/

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
.env*

# capacitor native build artifacts (machine-specific; android/ and ios/
# source + config ARE committed, only generated build output is excluded)
/android/build/
/android/app/build/
/android/capacitor-cordova-android-plugins/build/
/android/.gradle/
/android/local.properties
/ios/App/Pods/
/ios/App/build/
/ios/App/output/
/ios/DerivedData/
/android/.idea/

# admin/ is a separate Next.js app with its own install/build output
admin/node_modules
admin/.next/
admin/out/
admin/build/
admin/*.tsbuildinfo
admin/next-env.d.ts
admin/.env
admin/.env*.local
admin/.vercel
