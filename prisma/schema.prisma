// VybeMatch MVP data model.
// Design notes (see /docs strategy doc for the full rationale):
// - Postgres via Prisma so the schema is portable across Neon / Supabase / RDS / Cloud SQL.
// - Every table that will get hot at scale (Swipe, Message) is written so it can be
//   sharded by userId/matchId later without a redesign.
// - IntentType is a first-class, queryable column (not a tag string) because discovery
//   filtering on it is the core product mechanic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IntentType {
  JUST_VIBING
  SOMETHING_REAL
  RISHTA_READY
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SwipeAction {
  PASS
  VYBE // a "like" — renamed from PANGA to match the VybeMatch rebrand. Not
       // shown anywhere in the UI (see app/discover/page.tsx for the copy).
       // Postgres enum-value renames relabel existing rows in place (no
       // backfill needed), but this still needs its own migration — see
       // the apply instructions.
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// TEXT is a normal chat bubble. PROMPT is a tap-to-answer conversation
// starter ("Chai tapri or fancy cafe?" + two buttons) -- see
// lib/conversationStarters.ts for how these get generated from two
// people's shared interests/tribes, and app/matches/[matchId]/page.tsx
// for how tapping an option just sends a normal TEXT reply with that
// option's label, rather than needing any stateful "who answered" tracking.
// PLAN is the static card rendered by "Make a plan" (activity + vibe),
// meant to be discussed in ordinary messages underneath it.
enum MessageKind {
  TEXT
  PROMPT
  PLAN
  // The "📹 Quick video Vybe" offer (see the post-match spec's progressive-
  // unlocking section) -- a lightweight, tap-to-respond invite like PROMPT,
  // not a real video call: this MVP has no calling infrastructure, so
  // tapping either option just sends a normal TEXT reply, same mechanic as
  // PROMPT/PLAN. meta is `{}` (no payload needed beyond the kind itself).
  VIDEO_VYBE
}

model User {
  id            String   @id @default(cuid())
  // Every identity field below is optional and independently unique: a user
  // signs up with exactly one of them (phone OTP, email OTP, Google,
  // Facebook) but the schema doesn't force a "primary" method, so any of
  // them can be null. At real scale this becomes a separate AuthIdentity
  // join table (see the Swipe/Message models for the same "start simple,
  // note the real-scale shape" pattern) so one person can link more than
  // one method to the same account — not needed yet at MVP size.
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  email         String?  @unique
  emailVerified Boolean  @default(false)
  googleId      String?  @unique
  facebookId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActiveAt  DateTime @default(now())

  profile Profile?

  otpCodes         OtpCode[]
  swipesSent       Swipe[]        @relation("SwipesBySender")
  swipesReceived   Swipe[]        @relation("SwipesByTarget")
  matchesAsUserA   Match[]        @relation("MatchUserA")
  matchesAsUserB   Match[]        @relation("MatchUserB")
  messagesSent     Message[]      @relation("MessagesBySender")
  reportsFiled     Report[]       @relation("ReportsByReporter")
  reportsReceived  Report[]       @relation("ReportsAboutUser")
  blocksMade       Block[]        @relation("BlocksByBlocker")
  blocksReceived   Block[]        @relation("BlocksByBlocked")
  dateFeedback     DateFeedback[]
  messageLikes     MessageLike[]

  @@index([lastActiveAt])
}

model Profile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  dateOfBirth DateTime
  gender      Gender
  lookingFor  Gender[]
  city        String
  bio         String   @default("")

  intent           IntentType @default(SOMETHING_REAL)
  quietMode        Boolean    @default(false) // paused from discovery, profile kept
  verification     VerificationStatus @default(UNVERIFIED)
  familyPreviewOn  Boolean    @default(false) // Rishta Ready: optional shareable preview

  avatarSeed  String  @default("A") // fallback glyph shown only if a profile somehow has no photos
  avatarHue   Int     @default(1)   // 1..6, picks the fallback gradient behind that glyph

  // Optional, opt-in precise location (browser Geolocation API, set from
  // the Profile screen's "Location" section -- never collected silently).
  // Only ever used to compute a rounded *distance* shown to someone else
  // (see lib/geo.ts) -- raw latitude/longitude for another person's
  // profile is never sent to the client, only back to its own owner.
  latitude         Float?
  longitude        Float?
  locationUpdatedAt DateTime?

  interests          Interest[]          @relation("ProfileInterests")
  tribes              Tribe[]             @relation("ProfileTribes")
  subCommunities      SubCommunity[]      @relation("ProfileSubCommunities")
  relationshipStyles  RelationshipStyle[] @relation("ProfileRelationshipStyles")
  answers   PromptAnswer[]
  photos    Photo[]

  // --- Just Vibing only (see lib/constants.ts DATE_VIBES / TONIGHT_OPTIONS) ---
  // Plain string tags, not relations: single-intent, no drill-down, no
  // cross-intent reuse — a full Tribe-style table would be overkill.
  dateVibeTags String[] @default([]) // "What's your kind of date?" — exactly 3
  tonightTags  String[] @default([]) // "What are you looking for tonight?" — up to 2

  // --- Rishta Ready only (see lib/constants.ts LIVING_PREFERENCES / VALUES_OPTIONS / FUTURE_VIBE_QUESTIONS / CHILDREN_OPTIONS) ---
  livingPreference String?  // Basics step's extra question — one of 4 fixed slugs
  valuesTags       String[] @default([]) // "What matters most?" — exactly 4
  futureHome       String?  // one of FUTURE_VIBE_QUESTIONS('home').optionA/B slugs
  futureFamily     String?
  futureCareer     String?
  futureMoney      String?
  children         String?  // one of CHILDREN_OPTIONS slugs — deliberately 3-way, not binary

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, intent, quietMode])
}

// 1-5 photos per profile (enforced in app/api/profile/route.ts and
// app/api/profile/photos/route.ts, not at the schema level — Prisma/Postgres
// don't express "array of relations, length 1-5" as a constraint). `url`
// points at Vercel Blob for real uploads, or an external placeholder image
// for seeded demo profiles — the column doesn't care which.
model Photo {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0) // display order, 0 = primary photo
  createdAt DateTime @default(now())

  @@index([profileId, position])
}

model Interest {
  id       String       @id @default(cuid())
  label    String       @unique
  emoji    String       @default("")
  // Playful first-person phrase shown on the discover reveal card instead
  // of the plain label (e.g. "Take me somewhere" for Travel & exploring) —
  // see components/VibeCard.tsx. The plain label is still what onboarding
  // and profile pick-list chips show, since selection needs to be
  // unambiguous, not cute.
  tagline  String       @default("")
  // Which onboarding intents offer this interest — empty means all three.
  // Lets the "What are you into?" pick-list feel tailored per intent
  // (e.g. Nightlife only for Just Vibing) without three separate tables.
  intents  IntentType[] @default([])
  profiles Profile[]    @relation("ProfileInterests")
}

// The deep-cut layer under Interest — see the "What's your tribe?"
// onboarding step and the TRIBES constant in lib/constants.ts for the
// full rationale (personaLabel/activityPhrase/sharedPhrase usage).
model Tribe {
  id             String         @id @default(cuid())
  slug           String         @unique
  label          String
  emoji          String         @default("")
  personaLabel   String         @default("")
  activityPhrase String         @default("")
  sharedPhrase   String         @default("")
  // Which onboarding intents show this tribe — empty means both
  // Something Real and Rishta Ready (Just Vibing never sees Tribe at
  // all; that step doesn't exist in its flow).
  intents        IntentType[]   @default([])
  subCommunities SubCommunity[]
  profiles       Profile[]      @relation("ProfileTribes")
}

// Belongs to exactly one Tribe (e.g. "Nintendo" under Gaming), but many
// profiles can share the same one — that's the richer compatibility
// signal Tribe exists for.
model SubCommunity {
  id       String    @id @default(cuid())
  tribeId  String
  tribe    Tribe     @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  label    String
  profiles Profile[] @relation("ProfileSubCommunities")

  @@unique([tribeId, label])
}

// "My ideal relationship is…" onboarding step — the values layer, exactly
// 3 picked per profile (enforced in app/api/profile/route.ts). pairPhrase
// is the "Both X" line used on the Vibe Match reveal (lib/vibeMatch.ts).
model RelationshipStyle {
  id         String    @id @default(cuid())
  label      String    @unique
  emoji      String    @default("")
  pairPhrase String    @default("")
  profiles   Profile[] @relation("ProfileRelationshipStyles")
}

model Prompt {
  id      String       @id @default(cuid())
  text    String       @unique
  emoji   String       @default("")
  // Vybe Check is a forced binary pick, never free text — these are the
  // two fixed choices someone taps between for this prompt.
  optionA String       @default("")
  optionB String       @default("")
  // Vybe Check reads completely differently per intent (playful for Just
  // Vibing, relationship-facing for Something Real, future/family-facing
  // for Rishta Ready) — every real prompt is tagged to exactly one.
  // Empty means show everywhere (kept as an escape hatch, not used by the
  // current seed data).
  intents IntentType[] @default([])
  active  Boolean      @default(true)

  answers PromptAnswer[]
}

model PromptAnswer {
  id        String   @id @default(cuid())
  profileId String
  promptId  String
  answer    String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, promptId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Every swipe is recorded (not just mutual likes) so the discovery feed can
// exclude already-seen profiles and so the matching algorithm can learn later.
model Swipe {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())

  fromUser User @relation("SwipesBySender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("SwipesByTarget", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, action])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  unmatchedAt DateTime?
  // "Hide conversation" (see the chat screen's ... menu) removes a match
  // from just one person's list without unmatching or notifying the other
  // side -- one nullable timestamp per side, since Match doesn't have a
  // per-viewer row to hang a single flag off of.
  hiddenAAt DateTime?
  hiddenBAt DateTime?
  // "Mute" (see the ... safety menu) -- per side, suppresses nothing more
  // than a "new message" affordance client-side; this MVP has no push
  // notifications yet, so today this only silences the in-app unread
  // treatment, not a real notification.
  mutedAAt  DateTime?
  mutedBAt  DateTime?

  messages      Message[]
  dateFeedback  DateFeedback[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id        String        @id @default(cuid())
  matchId   String
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("MessagesBySender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  status    MessageStatus @default(SENT)
  kind      MessageKind   @default(TEXT)
  // Structured payload for PROMPT ({ question, emoji, options: [{label,
  // emoji}, {label, emoji}] }) and PLAN ({ activity: {label, emoji}, vibe
  // }) kinds -- see MessageKind above. Always null for plain TEXT.
  meta      Json?
  createdAt DateTime      @default(now())

  // Swipe-to-reply -- quotes an earlier message in this same match.
  // onDelete: SetNull so a reply survives its original being (hypothetically)
  // removed later, rather than cascading a delete through the whole thread.
  replyToId String?
  replyTo   Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]     @relation("MessageReplies")

  likes MessageLike[]

  @@index([matchId, createdAt])
}

// A lightweight "like" (heart) on a single message -- deliberately just a
// boolean per (message, user) rather than a full multi-emoji reaction
// system, since that's all the product ask calls for. Toggled by the
// liker; @@unique enforces one like per person per message.
model MessageLike {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  aboutId    String
  reporter   User     @relation("ReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  about      User     @relation("ReportsAboutUser", fields: [aboutId], references: [id], onDelete: Cascade)
  reason     String
  details    String   @default("")
  createdAt  DateTime @default(now())

  @@index([aboutId])
}

// Blocking a match (see the chat screen's ... menu) creates one of these,
// ends the match (unmatchedAt), and excludes both directions from each
// other's discover feed from then on -- see app/api/discover/route.ts.
// Deliberately directional/one-row, unlike Match's ordered-pair unique
// constraint: only the blocker's choice matters, so there's nothing to
// dedupe against a reverse row.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksByBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksByBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Private, own-eyes-only post-date check-in ("How did the Vybe feel?" --
// see the post-match spec). Never shown to the other person; a real
// "did they actually meet" signal doesn't exist here, so the chat screen
// offers this once a plan has been proposed and surfaces it as optional,
// dismissible UI rather than trying to detect an actual date happening.
model DateFeedback {
  id                  String   @id @default(cuid())
  matchId             String
  userId              String
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating              String   // 'MEET_AGAIN' | 'MAYBE' | 'NOT_FOR_ME'
  wantsToKeepChatting Boolean?
  createdAt           DateTime @default(now())

  @@unique([matchId, userId])
}
