// VybeMatch MVP data model.
// Design notes (see /docs strategy doc for the full rationale):
// - Postgres via Prisma so the schema is portable across Neon / Supabase / RDS / Cloud SQL.
// - Every table that will get hot at scale (Swipe, Message) is written so it can be
//   sharded by userId/matchId later without a redesign.
// - IntentType is a first-class, queryable column (not a tag string) because discovery
//   filtering on it is the core product mechanic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IntentType {
  JUST_VIBING
  SOMETHING_REAL
  RISHTA_READY
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum SwipeAction {
  PASS
  VYBE // a "like" — renamed from PANGA to match the VybeMatch rebrand. Not
       // shown anywhere in the UI (see app/discover/page.tsx for the copy).
       // Postgres enum-value renames relabel existing rows in place (no
       // backfill needed), but this still needs its own migration — see
       // the apply instructions.
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// TEXT is a normal chat bubble. PROMPT is a tap-to-answer conversation
// starter ("Chai tapri or fancy cafe?" + two buttons) -- see
// lib/conversationStarters.ts for how these get generated from two
// people's shared interests/tribes, and app/matches/[matchId]/page.tsx
// for how tapping an option just sends a normal TEXT reply with that
// option's label, rather than needing any stateful "who answered" tracking.
// PLAN is the static card rendered by "Make a plan" (activity + vibe),
// meant to be discussed in ordinary messages underneath it.
enum MessageKind {
  TEXT
  PROMPT
  PLAN
  // The "📹 Quick video Vybe" offer (see the post-match spec's progressive-
  // unlocking section) -- a lightweight, tap-to-respond invite like PROMPT,
  // not a real video call: this MVP has no calling infrastructure, so
  // tapping either option just sends a normal TEXT reply, same mechanic as
  // PROMPT/PLAN. meta is `{}` (no payload needed beyond the kind itself).
  VIDEO_VYBE
}

// --- Admin Portal: account status -----------------------------------------
// Distinct from Report/Block (which are user-initiated signals) -- this is
// the actual enforcement state Trust & Safety sets via the admin portal.
enum AccountStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id            String   @id @default(cuid())
  // Every identity field below is optional and independently unique: a user
  // signs up with exactly one of them (phone OTP, email OTP, Google,
  // Facebook) but the schema doesn't force a "primary" method, so any of
  // them can be null. At real scale this becomes a separate AuthIdentity
  // join table (see the Swipe/Message models for the same "start simple,
  // note the real-scale shape" pattern) so one person can link more than
  // one method to the same account — not needed yet at MVP size.
  phone         String?  @unique
  phoneVerified Boolean  @default(false)
  email         String?  @unique
  emailVerified Boolean  @default(false)
  googleId      String?  @unique
  facebookId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActiveAt  DateTime @default(now())

  // --- Admin Portal: Trust & Safety enforcement state ---------------------
  // Set exclusively via admin portal user actions (never by the consumer
  // app itself) -- see admin/lib/userActions.ts. Every change here is
  // paired with an AuditLogEntry.
  status               AccountStatus @default(ACTIVE)
  statusReason         String?
  statusChangedAt      DateTime?
  messagingRestricted  Boolean       @default(false)
  discoveryRestricted  Boolean       @default(false)
  // Stronger than discoveryRestricted: also hidden from existing matches,
  // not just excluded from new Discovery results -- see
  // admin/app/api/users/[userId]/actions/route.ts's 'hideProfile' action.
  profileHidden        Boolean       @default(false)
  deletionRequestedAt  DateTime?
  deletedAt            DateTime?
  // "Force logout" (admin User Action) -- any session JWT issued before
  // this timestamp is rejected by lib/session.ts's getSession(), even
  // though the JWT itself is still cryptographically valid. This is what
  // makes force-logout real against an otherwise-stateless JWT cookie
  // without standing up a full session table for the consumer app.
  sessionsInvalidatedAt DateTime?

  profile Profile?

  otpCodes         OtpCode[]
  swipesSent       Swipe[]        @relation("SwipesBySender")
  swipesReceived   Swipe[]        @relation("SwipesByTarget")
  matchesAsUserA   Match[]        @relation("MatchUserA")
  matchesAsUserB   Match[]        @relation("MatchUserB")
  messagesSent     Message[]      @relation("MessagesBySender")
  reportsFiled     Report[]       @relation("ReportsByReporter")
  reportsReceived  Report[]       @relation("ReportsAboutUser")
  blocksMade       Block[]        @relation("BlocksByBlocker")
  blocksReceived   Block[]        @relation("BlocksByBlocked")
  dateFeedback     DateFeedback[]
  messageLikes     MessageLike[]

  // --- Admin Portal: relations from the admin-domain models below ---------
  moderationCases     ModerationCase[]   @relation("ModerationCasesAboutUser")
  moderationAppeals   ModerationAppeal[]
  supportTickets      SupportTicket[]
  consentRecords       ConsentRecord[]
  privacyRequests      PrivacyRequest[]
  legalHolds           LegalHold[]
  loginEvents          LoginEvent[]

  @@index([lastActiveAt])
  @@index([status])
}

model Profile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  dateOfBirth DateTime
  gender      Gender
  lookingFor  Gender[]
  city        String
  bio         String   @default("")

  intent           IntentType @default(SOMETHING_REAL)
  quietMode        Boolean    @default(false) // paused from discovery, profile kept
  verification     VerificationStatus @default(UNVERIFIED)
  familyPreviewOn  Boolean    @default(false) // Rishta Ready: optional shareable preview

  avatarSeed  String  @default("A") // fallback glyph shown only if a profile somehow has no photos
  avatarHue   Int     @default(1)   // 1..6, picks the fallback gradient behind that glyph

  // Optional, opt-in precise location (browser Geolocation API, set from
  // the Profile screen's "Location" section -- never collected silently).
  // Only ever used to compute a rounded *distance* shown to someone else
  // (see lib/geo.ts) -- raw latitude/longitude for another person's
  // profile is never sent to the client, only back to its own owner.
  latitude         Float?
  longitude        Float?
  locationUpdatedAt DateTime?

  interests          Interest[]          @relation("ProfileInterests")
  tribes              Tribe[]             @relation("ProfileTribes")
  subCommunities      SubCommunity[]      @relation("ProfileSubCommunities")
  relationshipStyles  RelationshipStyle[] @relation("ProfileRelationshipStyles")
  answers   PromptAnswer[]
  photos    Photo[]

  // --- Just Vibing only (see lib/constants.ts DATE_VIBES / TONIGHT_OPTIONS) ---
  // Plain string tags, not relations: single-intent, no drill-down, no
  // cross-intent reuse — a full Tribe-style table would be overkill.
  dateVibeTags String[] @default([]) // "What's your kind of date?" — exactly 3
  tonightTags  String[] @default([]) // "What are you looking for tonight?" — up to 2

  // --- Rishta Ready only (see lib/constants.ts LIVING_PREFERENCES / VALUES_OPTIONS / FUTURE_VIBE_QUESTIONS / CHILDREN_OPTIONS) ---
  livingPreference String?  // Basics step's extra question — one of 4 fixed slugs
  valuesTags       String[] @default([]) // "What matters most?" — exactly 4
  futureHome       String?  // one of FUTURE_VIBE_QUESTIONS('home').optionA/B slugs
  futureFamily     String?
  futureCareer     String?
  futureMoney      String?
  children         String?  // one of CHILDREN_OPTIONS slugs — deliberately 3-way, not binary

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, intent, quietMode])
}

// 1-5 photos per profile (enforced in app/api/profile/route.ts and
// app/api/profile/photos/route.ts, not at the schema level — Prisma/Postgres
// don't express "array of relations, length 1-5" as a constraint). `url`
// points at Vercel Blob for real uploads, or an external placeholder image
// for seeded demo profiles — the column doesn't care which.
model Photo {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0) // display order, 0 = primary photo
  createdAt DateTime @default(now())

  // Admin-driven soft removal (Content Moderation's "remove/disable
  // photo") -- kept as a row rather than hard-deleted so the moderation
  // case's evidence/history stays intact. The consumer app filters these
  // out wherever it renders a profile's photos.
  removedAt     DateTime?
  removedReason String?

  @@index([profileId, position])
}

model Interest {
  id       String       @id @default(cuid())
  label    String       @unique
  emoji    String       @default("")
  // Playful first-person phrase shown on the discover reveal card instead
  // of the plain label (e.g. "Take me somewhere" for Travel & exploring) —
  // see components/VibeCard.tsx. The plain label is still what onboarding
  // and profile pick-list chips show, since selection needs to be
  // unambiguous, not cute.
  tagline  String       @default("")
  // Which onboarding intents offer this interest — empty means all three.
  // Lets the "What are you into?" pick-list feel tailored per intent
  // (e.g. Nightlife only for Just Vibing) without three separate tables.
  intents  IntentType[] @default([])
  profiles Profile[]    @relation("ProfileInterests")
}

// The deep-cut layer under Interest — see the "What's your tribe?"
// onboarding step and the TRIBES constant in lib/constants.ts for the
// full rationale (personaLabel/activityPhrase/sharedPhrase usage).
model Tribe {
  id             String         @id @default(cuid())
  slug           String         @unique
  label          String
  emoji          String         @default("")
  personaLabel   String         @default("")
  activityPhrase String         @default("")
  sharedPhrase   String         @default("")
  // Which onboarding intents show this tribe — empty means both
  // Something Real and Rishta Ready (Just Vibing never sees Tribe at
  // all; that step doesn't exist in its flow).
  intents        IntentType[]   @default([])
  subCommunities SubCommunity[]
  profiles       Profile[]      @relation("ProfileTribes")
}

// Belongs to exactly one Tribe (e.g. "Nintendo" under Gaming), but many
// profiles can share the same one — that's the richer compatibility
// signal Tribe exists for.
model SubCommunity {
  id       String    @id @default(cuid())
  tribeId  String
  tribe    Tribe     @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  label    String
  profiles Profile[] @relation("ProfileSubCommunities")

  @@unique([tribeId, label])
}

// "My ideal relationship is…" onboarding step — the values layer, exactly
// 3 picked per profile (enforced in app/api/profile/route.ts). pairPhrase
// is the "Both X" line used on the Vibe Match reveal (lib/vibeMatch.ts).
model RelationshipStyle {
  id         String    @id @default(cuid())
  label      String    @unique
  emoji      String    @default("")
  pairPhrase String    @default("")
  profiles   Profile[] @relation("ProfileRelationshipStyles")
}

model Prompt {
  id      String       @id @default(cuid())
  text    String       @unique
  emoji   String       @default("")
  // Vybe Check is a forced binary pick, never free text — these are the
  // two fixed choices someone taps between for this prompt.
  optionA String       @default("")
  optionB String       @default("")
  // Vybe Check reads completely differently per intent (playful for Just
  // Vibing, relationship-facing for Something Real, future/family-facing
  // for Rishta Ready) — every real prompt is tagged to exactly one.
  // Empty means show everywhere (kept as an escape hatch, not used by the
  // current seed data).
  intents IntentType[] @default([])
  active  Boolean      @default(true)

  answers PromptAnswer[]
}

model PromptAnswer {
  id        String   @id @default(cuid())
  profileId String
  promptId  String
  answer    String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, promptId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Every swipe is recorded (not just mutual likes) so the discovery feed can
// exclude already-seen profiles and so the matching algorithm can learn later.
model Swipe {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())

  fromUser User @relation("SwipesBySender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("SwipesByTarget", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, action])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  unmatchedAt DateTime?
  // "Hide conversation" (see the chat screen's ... menu) removes a match
  // from just one person's list without unmatching or notifying the other
  // side -- one nullable timestamp per side, since Match doesn't have a
  // per-viewer row to hang a single flag off of.
  hiddenAAt DateTime?
  hiddenBAt DateTime?
  // "Mute" (see the ... safety menu) -- per side, suppresses nothing more
  // than a "new message" affordance client-side; this MVP has no push
  // notifications yet, so today this only silences the in-app unread
  // treatment, not a real notification.
  mutedAAt  DateTime?
  mutedBAt  DateTime?

  messages      Message[]
  dateFeedback  DateFeedback[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id        String        @id @default(cuid())
  matchId   String
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("MessagesBySender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  status    MessageStatus @default(SENT)
  kind      MessageKind   @default(TEXT)
  // Structured payload for PROMPT ({ question, emoji, options: [{label,
  // emoji}, {label, emoji}] }) and PLAN ({ activity: {label, emoji}, vibe
  // }) kinds -- see MessageKind above. Always null for plain TEXT.
  meta      Json?
  createdAt DateTime      @default(now())

  // Swipe-to-reply -- quotes an earlier message in this same match.
  // onDelete: SetNull so a reply survives its original being (hypothetically)
  // removed later, rather than cascading a delete through the whole thread.
  replyToId String?
  replyTo   Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]     @relation("MessageReplies")

  likes MessageLike[]

  @@index([matchId, createdAt])
}

// A lightweight "like" (heart) on a single message -- deliberately just a
// boolean per (message, user) rather than a full multi-emoji reaction
// system, since that's all the product ask calls for. Toggled by the
// liker; @@unique enforces one like per person per message.
model MessageLike {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  aboutId    String
  reporter   User     @relation("ReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  about      User     @relation("ReportsAboutUser", fields: [aboutId], references: [id], onDelete: Cascade)
  reason     String
  details    String   @default("")
  createdAt  DateTime @default(now())

  moderationCases ModerationCase[]

  @@index([aboutId])
}

// Blocking a match (see the chat screen's ... menu) creates one of these,
// ends the match (unmatchedAt), and excludes both directions from each
// other's discover feed from then on -- see app/api/discover/route.ts.
// Deliberately directional/one-row, unlike Match's ordered-pair unique
// constraint: only the blocker's choice matters, so there's nothing to
// dedupe against a reverse row.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksByBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksByBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Private, own-eyes-only post-date check-in ("How did the Vybe feel?" --
// see the post-match spec). Never shown to the other person; a real
// "did they actually meet" signal doesn't exist here, so the chat screen
// offers this once a plan has been proposed and surfaces it as optional,
// dismissible UI rather than trying to detect an actual date happening.
model DateFeedback {
  id                  String   @id @default(cuid())
  matchId             String
  userId              String
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating              String   // 'MEET_AGAIN' | 'MAYBE' | 'NOT_FOR_ME'
  wantsToKeepChatting Boolean?
  createdAt           DateTime @default(now())

  @@unique([matchId, userId])
}

// =============================================================================
// ADMIN PORTAL DOMAIN
// -----------------------------------------------------------------------------
// Everything below backs the separate admin/ app (admin/README.md). It shares
// this exact schema file (see admin/prisma.config.ts) and this database --
// there is no duplicate schema to drift out of sync. Consumer-facing models
// above are untouched except for the small, clearly-commented additions
// (User.status/*, Report.moderationCases) needed so admin actions can attach
// to real user/report rows.
// =============================================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  TRUST_AND_SAFETY
  MODERATOR
  CUSTOMER_SUPPORT
  PRIVACY_OFFICER
  COMPLIANCE_OFFICER
  FINANCE
  ANALYTICS
  READ_ONLY
}

model AdminUser {
  id       String    @id @default(cuid())
  email    String    @unique
  name     String
  passwordHash String
  role     AdminRole @default(READ_ONLY)
  isActive Boolean   @default(true)

  // TOTP-based MFA (see admin/lib/mfa.ts). Recovery codes are stored hashed,
  // one-time-use (consumed codes are removed from the array).
  mfaSecret        String?
  mfaEnabled       Boolean  @default(false)
  mfaRecoveryCodes String[] @default([])

  lastLoginAt DateTime?
  lastLoginIp String?

  // Basic brute-force protection -- incremented on each failed password
  // attempt in admin/app/api/auth/login/route.ts, reset on success.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdById String?
  createdBy   AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins AdminUser[] @relation("AdminCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                AdminSession[]
  auditLogs               AuditLogEntry[]        @relation("AuditActor")
  moderationCasesAssigned ModerationCase[]        @relation("CaseAssignee")
  moderationNotes         ModerationNote[]
  appealsReviewed         ModerationAppeal[]      @relation("AppealReviewer")
  supportTicketsAssigned  SupportTicket[]         @relation("TicketAssignee")
  ticketMessages          TicketMessage[]
  privacyRequestsHandled  PrivacyRequest[]        @relation("PrivacyRequestHandler")
  legalHoldsRequested     LegalHold[]             @relation("LegalHoldRequestedBy")
  privacyIncidentsOwned   PrivacyIncident[]
  privacyIncidentEvents   PrivacyIncidentEvent[]
  processingActivitiesOwned ProcessingActivity[]
  featureFlagsUpdated     FeatureFlag[]
  configChangesProposed   AppConfigChange[]       @relation("ConfigProposer")
  configChangesReviewed   AppConfigChange[]       @relation("ConfigReviewer")
  notificationTemplatesUpdated NotificationTemplate[]
  opsAlertsAcknowledged   OpsAlert[]

  @@index([role])
}

// DB-backed (not stateless JWT) so sessions can be listed and force-revoked
// -- required for "Force logout" and session/IP controls on admins
// themselves, not just on consumer users. `stepUpAt` tracks the last time
// this session re-proved identity (password + MFA) for gating destructive
// actions with step-up auth without demanding it on every click.
model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  stepUpAt  DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([adminId])
  @@index([expiresAt])
}

// Tamper-resistant by convention: the admin API never exposes an update or
// delete for this model (see admin/app/api/audit/route.ts -- GET only), and
// the deployment notes (admin/README.md) call out revoking UPDATE/DELETE
// grants on this table for the app's DB role as a production hardening step.
// One row per sensitive action, everywhere in the portal.
model AuditLogEntry {
  id       String     @id @default(cuid())
  actorId  String?
  actor    AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Denormalized so the log stays readable even after an AdminUser is
  // removed (actorId goes null via onDelete: SetNull, actorEmail does not).
  actorEmail String

  action   String // dot-path, e.g. "user.suspend", "privacy_request.complete"
  category String // "user" | "moderation" | "content" | "support" | "privacy" | "auth" | "config" | "payments" | "system"

  targetType String? // "User" | "AdminUser" | "ModerationCase" | ...
  targetId   String?

  previousValue Json?
  newValue      Json?
  reason        String?

  requestId String
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([category, createdAt])
  @@index([createdAt])
}

enum ModerationSourceType {
  USER_REPORT
  AUTOMATED_FLAG
  CONTENT_REVIEW
  ADMIN_INITIATED
}

enum ModerationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  RESOLVED
  DISMISSED
}

enum AppealStatus {
  PENDING
  UPHELD
  OVERTURNED
}

// The one work-item type for all of Trust & Safety + Content Moderation --
// a user report, an automated risk flag, a photo/bio review, or something
// an admin opened by hand all become a ModerationCase, distinguished by
// sourceType/category. This is deliberately one model rather than a
// separate table per source, so there is one queue, one SLA clock, and one
// history per subject user, matching how the spec describes a single
// "Safety Centre".
model ModerationCase {
  id            String   @id @default(cuid())
  subjectUserId String
  subjectUser   User     @relation("ModerationCasesAboutUser", fields: [subjectUserId], references: [id], onDelete: Cascade)

  sourceType ModerationSourceType
  reportId   String?
  report     Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)

  // harassment | scam_fraud | fake_catfish | underage | sexual_content |
  // threats_blackmail | spam | suspicious_behavior | photo_violation |
  // bio_violation | message_violation | other
  category String
  severity ModerationSeverity   @default(MEDIUM)
  status   ModerationCaseStatus @default(OPEN)

  assigneeId String?
  assignee   AdminUser? @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  slaDueAt DateTime?

  // Internal automated-risk score (0-1). Never returned by any API a
  // non-Trust-and-Safety/Compliance role can call -- see admin/lib/rbac.ts
  // PERMISSIONS.moderation.viewRiskScore. "Never expose internal
  // risk/scoring algorithms to normal admins" from the spec.
  riskScore Float?

  // Structured references to the evidence: report ids, message ids, photo
  // urls, automated-flag payload -- shape documented in admin/lib/types.ts.
  evidence Json?

  isRepeatOffender Boolean @default(false)

  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes   ModerationNote[]
  appeals ModerationAppeal[]

  @@index([status, severity])
  @@index([subjectUserId])
  @@index([assigneeId])
  @@index([sourceType])
}

model ModerationNote {
  id       String         @id @default(cuid())
  caseId   String
  case     ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId String
  author   AdminUser      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body     String

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model ModerationAppeal {
  id     String         @id @default(cuid())
  caseId String
  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  status  AppealStatus @default(PENDING)

  reviewedById String?
  reviewedBy   AdminUser? @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([status])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketChannel {
  VYBEHELP_ESCALATION
  EMAIL
  IN_APP_FORM
  ADMIN_CREATED
}

model SupportTicket {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // A ticket can exist before/without a matched account (e.g. someone
  // emailing in) -- userId is nullable for exactly that.
  contactEmail String?
  contactPhone String?

  subject  String
  // account | profile | matching | discover | chat | safety | verification
  // | privacy | technical | other
  category String
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)
  channel  TicketChannel  @default(IN_APP_FORM)

  assigneeId String?
  assignee   AdminUser? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  slaDueAt    DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?

  // The VybeHelp 💬 transcript that led here, when escalated from
  // self-service rather than opened directly -- see
  // app/api/help/ask/route.ts (consumer app) and
  // admin/app/api/support/escalate/route.ts.
  vybeHelpTranscript Json?

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([userId])
  @@index([assigneeId])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType    String // 'user' | 'admin' | 'system'
  authorAdminId String?
  authorAdmin   AdminUser? @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  body        String
  // Internal-only note, never shown to the user -- distinct from a reply.
  internal    Boolean  @default(false)
  attachments String[] @default([])

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// =============================================================================
// PRIVACY & DPDP COMPLIANCE
// -----------------------------------------------------------------------------
// Modeled around the Digital Personal Data Protection Act 2023 and the
// notified DPDP Rules 2025: explicit purpose-tagged consent with a
// versioned notice, a Data Principal's statutory rights (access,
// correction, erasure, grievance redressal, and portability where
// applicable), retention/deletion workflows, legal holds that can
// override a deletion, and a breach/incident workflow with Data
// Protection Board notification tracking. This is documentation +
// workflow tooling for a compliance/privacy team to operate, not a legal
// opinion -- see admin/docs/DPDP_COMPLIANCE.md for what still needs
// counsel sign-off before go-live (the Board's rules commence in phases).
// =============================================================================

enum ConsentPurpose {
  ACCOUNT_ESSENTIAL
  PRECISE_LOCATION
  MARKETING_COMMUNICATIONS
  ANALYTICS
  THIRD_PARTY_SHARING
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

// Append-only: withdrawing consent inserts a new WITHDRAWN row rather than
// mutating the GRANTED one, so the full consent history for a purpose is
// always reconstructable (DPDP requires being able to show what a Data
// Principal actually agreed to, and when).
model ConsentRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose       ConsentPurpose
  status        ConsentStatus
  noticeVersion String // which version of the privacy notice was shown
  source        String // 'onboarding' | 'settings' | 'reconsent_prompt' | 'admin_backfill'
  ip            String?
  userAgent     String?

  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  DELETION
  GRIEVANCE
  PORTABILITY
  CONSENT_WITHDRAWAL
}

enum PrivacyRequestStatus {
  RECEIVED
  VERIFYING_IDENTITY
  IN_PROGRESS
  ON_HOLD_LEGAL
  COMPLETED
  REJECTED
}

// One model for every Data Principal right in the Act (access, correction,
// erasure, grievance, and portability where applicable) -- `type`
// distinguishes them since the workflow shape (received -> verify identity
// -> action -> respond) is the same for all five.
model PrivacyRequest {
  id           String  @id @default(cuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactEmail String? // for a request made before/without a matched account

  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(RECEIVED)
  description String               @default("")

  // Target response date the compliance team commits to internally.
  dueAt DateTime?

  handledById    String?
  handledBy      AdminUser? @relation("PrivacyRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  resolutionNote String?

  // Time-limited signed download for ACCESS / PORTABILITY -- generated,
  // never a permanent public link (see admin/lib/privacyExport.ts).
  exportFileUrl String?
  exportExpiresAt DateTime?

  legalHoldId String?
  legalHold   LegalHold? @relation(fields: [legalHoldId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, type])
  @@index([userId])
}

// A DELETION request against a user who is under a legal hold is blocked
// (status ON_HOLD_LEGAL) rather than silently actioned -- see
// admin/lib/privacyWorkflow.ts.
model LegalHold {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reason        String
  requestedById String
  requestedBy   AdminUser @relation("LegalHoldRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  privacyRequests PrivacyRequest[]

  @@index([userId, active])
}

enum PrivacyIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PrivacyIncidentStatus {
  DETECTED
  ASSESSING
  CONTAINED
  BOARD_NOTIFIED // Data Protection Board of India, per DPDP breach-notification rules
  USERS_NOTIFIED
  CLOSED
}

model PrivacyIncident {
  id          String @id @default(cuid())
  title       String
  description String
  severity    PrivacyIncidentSeverity
  status      PrivacyIncidentStatus   @default(DETECTED)

  affectedUserCount      Int?
  affectedDataCategories String[] @default([])

  detectedAt      DateTime
  containedAt     DateTime?
  boardNotifiedAt DateTime?
  usersNotifiedAt DateTime?

  rootCause   String?
  remediation String?

  ownerId String?
  owner   AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeline PrivacyIncidentEvent[]

  @@index([status, severity])
}

model PrivacyIncidentEvent {
  id         String          @id @default(cuid())
  incidentId String
  incident   PrivacyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  note      String
  authorId  String?
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([incidentId, createdAt])
}

// Vendor/processor register -- who else touches user data and why (SMS/OTP
// gateway, verification/KYC vendor, cloud hosting, blob storage, ...).
model DataProcessor {
  id             String    @id @default(cuid())
  name           String
  purpose        String
  dataCategories String[]  @default([])
  country        String    @default("India")
  contractRef    String?
  dpaSignedAt    DateTime? // Data Processing Agreement
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Configurable per data category so retention isn't hard-coded across the
// app; `autoDeleteEnabled` gates whether admin/lib/retentionJob.ts actually
// purges past-retention rows automatically or just flags them for review.
model RetentionPolicy {
  id                String    @id @default(cuid())
  dataCategory      String    @unique // "OTP codes" | "Expired swipes" | "Deleted-account data" | ...
  retentionDays     Int
  autoDeleteEnabled Boolean   @default(false)
  legalBasis        String    @default("")
  lastReviewedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// The "record of processing activities" DPDP/most privacy regimes expect a
// controller to maintain -- lightweight documentation rows, not a live
// data-flow scanner.
model ProcessingActivity {
  id                  String   @id @default(cuid())
  name                String
  purpose             String
  dataCategories      String[] @default([])
  legalBasis          String
  dataSubjects        String   @default("App users (Data Principals)")
  recipients          String[] @default([])
  retentionCategoryRef String? // free-text pointer to a RetentionPolicy.dataCategory
  crossBorderTransfer Boolean  @default(false)
  dpiaRequired        Boolean  @default(false)
  dpiaDocUrl          String?

  ownerId String?
  owner   AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// CONFIGURATION, OPS & NOTIFICATIONS
// =============================================================================

model FeatureFlag {
  id             String  @id @default(cuid())
  key            String  @unique
  label          String
  description    String  @default("")
  enabled        Boolean @default(false)
  rolloutPercent Int     @default(100)

  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConfigChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
}

// A generic, append-only proposal log for the handful of "important"
// settings that need a second pair of eyes before taking effect (feature
// flags, maintenance mode, global notification templates) -- see
// admin/lib/configApproval.ts. Routine content edits (Interests, Tribes,
// Prompts -- already their own tables above) go through normal
// audit-logged CRUD instead of this approval queue.
model AppConfigChange {
  id            String @id @default(cuid())
  configKey     String // e.g. "maintenanceMode", "featureFlag:new_discovery_algo"
  previousValue Json?
  proposedValue Json

  status ConfigChangeStatus @default(PENDING_APPROVAL)

  proposedById String
  proposedBy   AdminUser @relation("ConfigProposer", fields: [proposedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   AdminUser? @relation("ConfigReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  appliedAt  DateTime?

  @@index([configKey, status])
}

model NotificationTemplate {
  id      String  @id @default(cuid())
  key     String  @unique // e.g. "account.suspended", "privacy.deletion.completed"
  channel String // 'email' | 'sms' | 'in_app'
  subject String?
  body    String

  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OpsAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OpsAlertCategory {
  SECURITY
  MODERATION
  SLA_BREACH
  SYSTEM
  PAYMENT
  VERIFICATION
  PRIVACY
  OUTAGE
}

model OpsAlert {
  id       String           @id @default(cuid())
  category OpsAlertCategory
  severity OpsAlertSeverity @default(WARNING)
  title    String
  detail   String           @default("")

  sourceType String? // 'ModerationCase' | 'SupportTicket' | 'PrivacyIncident' | 'system'
  sourceId   String?

  acknowledgedById String?
  acknowledgedBy   AdminUser? @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([category, severity, createdAt])
  @@index([acknowledgedAt])
}

// Login/session history for the User Management detail page ("Login/session
// history", "Account/device history" in the spec) -- the consumer app's
// auth endpoints write one of these per successful login (see
// app/api/auth/*/route.ts). Session itself stays the existing stateless
// JWT cookie (lib/session.ts, unchanged) -- this is a read history, not a
// second session store for the consumer app.
model LoginEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method    String // 'phone_otp' | 'email_otp' | 'google' | 'facebook'
  platform  String? // 'web' | 'ios' | 'android'
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
